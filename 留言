<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AI 數位永生 - 傷感留言互動模式</title>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@300;400;700&display=swap" rel="stylesheet">
    
    <style>
        body {
            margin: 0;
            background-color: #050505;
            font-family: 'Noto Sans TC', sans-serif;
            color: white;
            overflow-x: hidden;
        }

        .story-section {
            position: relative;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            background: radial-gradient(circle at center, #1a1a1a 0%, #050505 100%);
        }

        .section-bg {
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            background-image: url('https://images.unsplash.com/photo-1451187580459-43490279c0fa?q=80&w=2072&auto=format&fit=crop');
            background-size: cover;
            background-position: center;
            opacity: 0.1;
            z-index: -1;
            filter: grayscale(100%);
        }

        .glass {
            background: rgba(255, 255, 255, 0.02);
            backdrop-filter: blur(25px);
            -webkit-backdrop-filter: blur(25px);
            border: 1px solid rgba(255, 255, 255, 0.05);
            border-radius: 30px;
            padding: 30px;
            width: 95%;
            max-width: 950px;
            box-shadow: 0 0 50px rgba(0,0,0,0.9);
            z-index: 10;
        }

        h2 {
            font-size: 22px;
            font-weight: 300;
            border-left: 2px solid rgba(0, 212, 255, 0.4);
            padding-left: 20px;
            margin-bottom: 25px;
            letter-spacing: 5px;
            color: rgba(255,255,255,0.7);
        }

        .comment-box {
            position: relative;
            width: 100%;
            height: 600px; 
            overflow: hidden;
            mask-image: linear-gradient(to bottom, transparent, black 15%, black 85%, transparent);
            -webkit-mask-image: linear-gradient(to bottom, transparent, black 15%, black 85%, transparent);
            background: rgba(0, 0, 0, 0.4);
            border-radius: 20px;
        }

        .sad-icon {
            position: absolute;
            font-size: 24px;
            color: rgba(0, 212, 255, 0.3);
            filter: drop-shadow(0 0 5px rgba(0, 212, 255, 0.2));
            pointer-events: none;
            z-index: 1; /* 表情在底層 */
            user-select: none;
        }

        .comment-item {
            position: absolute;
            background: rgba(255, 255, 255, 0.08);
            border-left: 3px solid rgba(0, 212, 255, 0.5);
            padding: 16px 20px;
            border-radius: 6px;
            color: rgba(255,255,255,0.9);
            font-size: 0.95rem;
            width: 320px; 
            box-shadow: 0 10px 30px rgba(0,0,0,0.5);
            opacity: 0;
            pointer-events: none;
            will-change: transform, opacity;
            z-index: 5; /* 留言在表層 */
        }

        .comment-item b {
            display: block;
            color: rgba(0, 212, 255, 0.9);
            font-size: 0.75rem;
            margin-bottom: 8px;
            font-weight: 400;
            letter-spacing: 1px;
        }

        .comment-item p {
            margin: 0;
            line-height: 1.6;
            font-weight: 300;
        }

        @media (max-width: 768px) {
            .comment-item { width: 220px; font-size: 0.85rem; }
            .glass { padding: 15px; }
        }
    </style>
</head>
<body>

<main>
    <section class='story-section comment-stream-section'>
        <div class='section-bg'></div>
        <div class='content-narrow'>
            <div class='comment-container glass'>
                <h2>遺留下的思念．留言存檔</h2>
                <div id="comment-box" class="comment-box"></div>
            </div>
        </div>
    </section>
</main>

<script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js"></script>

<script>
    const comments = [
        { user: "@kama5544", text: "如果是去年的我也會覺得這只是單純的自己騙自己，但我爸上個月罹癌走了.....現在的我真的已經能體會這種感覺了。" },
        { user: "@aa1987aa", text: "大家都一面倒在罵，但是有些人的確必須靠思念、回憶才可以活下去不是嗎？" },
        { user: "@edwardtp", text: "過程很殘忍，現實很難過，而這是他對女兒的愛與懷念，利用現代科技唯一能做到的事情。" },
        { user: "@梓歆-z5e", text: "AI 真的幫助那些走不出陰霾的人。讓他們能把心裡的話解開，是一個溫柔的出口。" },
        { user: "@JasonSCTw", text: "既然他沒影響到外界，那就尊重即可，不必把自己的想法強加在別人身上。這何嘗不是一種「放下」？" },
        { user: "@peijenwei283", text: "走出悲傷就得將自已女兒忘了？他心理覺得幫女兒實現了願望，自然是歡喜的，何苦說人家是走不出？" },
        { user: "@jiaderjia3633", text: "也是個滿好的AI應用方式。例如有些失去父母的小孩，可用這方式讓父母繼續陪伴成長。" },
        { user: "@jjlu5345", text: "能讓活著的人好過一點，保存美好的記憶也沒什麼不好，只要不影響他人，看了很感動。" },
        { user: "@joyppable", text: "當巨大傷痛在心裡時，又有多少人知道怎麼治癒？如果能使用AI方式當作一種治療有何不可？" },
        { user: "@naall5919", text: "我也好想念我阿嬤，但在那個時代沒有錄影，想數位化也做不到QQ" },
        { user: "@markyaya123", text: "女兒這樣就走了，生不如死，如果這樣可以治療心理也是好的。" },
        { user: "@minami1644", text: "為什麼非得要走出來不可？這跟清明掃墓和已故親人說說話沒有什麼差別。" },
        { user: "@祭貓", text: "我去世爺爺或奶奶的人格被AI繼承，但我只能將他們視同很相近的人...我甚至感到害怕。" },
        { user: "@-ClementLee-", text: "這只是一張會動且能發出聲音的照片。放下不是忘記，科技可以更舒適的懷念。" },
        { user: "@yichen3796", text: "如果人往生，回憶有幫助就是好。端看在世人的家屬個性為何？" },
        { user: "@slamdunk33914", text: "對方只是比你先到那個世界等你，時候到了你也會到，到時就能團團圓了。" },
        { user: "@aalluubbaa", text: "科技是中性的。以前讀詩回憶，後來有相片，現在有AI。思念都是一樣的。" },
        { user: "@吳吳-n8z", text: "只要能給自己活下去的力量，有何不可？總比常常悲傷難過傷身體好吧。" }
    ];

    const sadIcons = ["😢", "⚡", "💔", "👼", "🕯️", "💧"];
    let commentIndex = 0;
    let isLeftSide = true;
    const commentBox = document.getElementById('comment-box');

    // 用來管理留言軌道，防止堆疊
    const trackLastPos = { left: 0, right: 0 };

    function spawnSadIcon() {
        const icon = document.createElement('div');
        icon.className = 'sad-icon';
        icon.innerText = sadIcons[Math.floor(Math.random() * sadIcons.length)];
        icon.style.left = Math.random() * 90 + 5 + '%';
        icon.style.bottom = "-50px";
        icon.style.opacity = "0";
        commentBox.appendChild(icon);

        gsap.to(icon, {
            opacity: Math.random() * 0.4 + 0.1,
            bottom: "110%",
            x: (Math.random() - 0.5) * 200,
            rotation: (Math.random() - 0.5) * 90,
            duration: 8 + Math.random() * 6,
            ease: "sine.inOut",
            onComplete: () => icon.remove()
        });
    }

    function createComment() {
        if (!commentBox) return;

        // 檢查當前軌道是否太擠
        const side = isLeftSide ? 'left' : 'right';
        const now = Date.now();
        
        // 確保同一軌道的留言間隔至少 3.5 秒，避免視覺重疊
        if (now - trackLastPos[side] < 3500) {
            isLeftSide = !isLeftSide; // 試試另一邊
            setTimeout(createComment, 200); // 延遲重試
            return;
        }

        trackLastPos[side] = now;

        const data = comments[commentIndex];
        const el = document.createElement('div');
        el.className = 'comment-item';
        el.innerHTML = `<b>${data.user}</b><p>${data.text}</p>`;

        // 計算位置：左半邊或右半邊
        let leftBase = isLeftSide ? 5 : 55;
        let randomOffset = Math.random() * 10; // 軌道內的小隨機
        el.style.left = `${leftBase + randomOffset}%`;
        el.style.bottom = "-250px"; 

        commentBox.appendChild(el);

        const tl = gsap.timeline({
            onComplete: () => el.remove()
        });

        // 1. 浮現動畫
        tl.to(el, {
            opacity: 1,
            bottom: "115%",
            duration: 14, // 稍微調慢讓閱讀更舒適
            ease: "none",
            x: () => (Math.random() - 0.5) * 30
        });

        // 2. 消失模糊
        tl.to(el, {
            opacity: 0,
            filter: "blur(12px)",
            duration: 3
        }, "-=3");

        isLeftSide = !isLeftSide;
        commentIndex = (commentIndex + 1) % comments.length;
        
        // 雖然全域間隔 1.5s，但內部會判斷軌道是否擁擠
        setTimeout(createComment, 1500);
    }

    window.addEventListener('load', () => {
        setInterval(spawnSadIcon, 600);
        createComment();
    });
</script>

</body>
</html>
