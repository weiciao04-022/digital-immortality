<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AI 數位永生 - 社群留言互動</title>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;700&display=swap" rel="stylesheet">
    
    <style>
        /* 基礎背景設定 */
        body {
            margin: 0;
            background-color: #0a0a0a;
            font-family: 'Noto Sans TC', sans-serif;
            color: white;
        }

        .story-section {
            position: relative;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }

        /* 留言區容器 */
        .glass {
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(15px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 20px;
            padding: 40px;
            width: 85%;
            max-width: 800px;
            box-shadow: 0 15px 35px rgba(0,0,0,0.5);
        }

        h2 {
            font-size: 24px;
            border-left: 5px solid #00d4ff;
            padding-left: 15px;
            margin-bottom: 30px;
        }

        /* 留言跳動的舞台區 */
        .comment-box {
            position: relative;
            width: 100%;
            height: 450px; /* 留言跳動的高度範圍 */
            overflow: hidden;
            mask-image: linear-gradient(to bottom, transparent, black 15%, black 85%, transparent);
        }

        /* 單個留言樣式 (CSS 補強) */
        .comment-item {
            position: absolute;
            background: rgba(255, 255, 255, 0.12);
            border-left: 4px solid #00d4ff;
            padding: 15px 20px;
            border-radius: 8px;
            color: #fff;
            font-size: 1rem;
            width: 300px; /* 固定寬度讓文字折行 */
            box-shadow: 0 4px 15px rgba(0,0,0,0.3);
            opacity: 0; /* 預設隱藏，由 GSAP 控制顯現 */
            pointer-events: none;
        }

        .comment-item b {
            display: block;
            color: #00d4ff;
            font-size: 0.85rem;
            margin-bottom: 5px;
        }

        .comment-item p {
            margin: 0;
            line-height: 1.5;
        }
    </style>
</head>
<body>

<main>
    <section class='story-section comment-stream-section' data-bg='pic/06taiwan-comments.png'>
        <div class='section-bg'></div>
        <div class='content-narrow'>
            <div class='comment-container glass'>
                <h2>社群迴響：思念的出口</h2>
                <div id="comment-box" class="comment-box">
                    </div>
            </div>
        </div>
    </section>
</main>

<script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js"></script>

<script>
    const comments = [
        { user: "@kama5544", text: "如果是去年的我也會覺得這只是單純的自己騙自己，但我爸上個月罹癌走了.....現在的我真的已經能體會這種感覺了，就算知道是假的，但心情上確實會好不少" },
        { user: "@aa1987aa", text: "大家都一面倒在罵，但是有些人的確必須靠思念、回憶才可以活下去不是嗎？" },
        { user: "@edwardtp", text: "過程很殘忍，現實很難過，而這是他對女兒的愛與懷念，利用現代科技唯一能做到的事情。" },
        { user: "@梓歆-z5e", text: "AI 真的幫助那些走不出陰霾的人，讓他們能把心裡的話解開，是一個不錯的應用。" },
        { user: "@JasonSCTw", text: "既然他沒影響到外界，那就尊重即可，不必把自己的想法強加在別人身上。" },
        { user: "@peijenwei283", text: "思念就只能是哀傷，卻不能是歡喜？他女兒此生得不到的健康，他爸爸用數位AI幫女兒實現了。" },
        { user: "@jiaderjia3633", text: "也是個滿好的AI應用方式，例如有些失去父母的小孩，可用這方式讓父母繼續陪伴成長。" },
        { user: "@jjlu5345", text: "能讓活著的人好過一點，保存美好的記憶也沒什麼不好，看了很感動。" },
        { user: "@joyppable", text: "當巨大傷痛在心裡時，又有多少人知道怎麼治癒？如果能使用AI方式當作一種治療有何不可？" }
    ];

    let commentIndex = 0;
    const commentBox = document.getElementById('comment-box');

    function createComment() {
        if (!commentBox) return;

        const data = comments[commentIndex];
        const el = document.createElement('div');
        el.className = 'comment-item';
        el.innerHTML = `<b>${data.user}</b><p>${data.text}</p>`;

        // 隨機決定水平位置 (5% ~ 60%)
        const randomLeft = Math.floor(Math.random() * 55) + 5;
        el.style.left = `${randomLeft}%`;
        el.style.bottom = "-20%"; // 初始在容器下方

        commentBox.appendChild(el);

        // GSAP 動畫：從底部升起並淡入
        const tl = gsap.timeline({
            onComplete: () => el.remove() // 結束後移除，維持效能
        });

        tl.to(el, {
            opacity: 1,
            bottom: "120%", // 往上移動超過容器
            duration: 8,    // 移動速度，數字越大越慢
            ease: "none"
        })
        .to(el, {
            opacity: 0,
            duration: 1.5
        }, "-=1.5"); // 最後 1.5 秒淡出

        commentIndex = (commentIndex + 1) % comments.length;
        
        // 設定下一次彈出的時間
        setTimeout(createComment, 2500);
    }

    // 啟動動畫
    window.addEventListener('load', () => {
        createComment();
    });
</script>

</body>
</html>
